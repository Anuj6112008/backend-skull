# ==========================================================
# SKULL TRADER — Backend environment variables
# Copy this file to .env for local dev, and set the same
# keys inside Vercel → Project → Settings → Environment Variables
# ==========================================================

# --- Firebase Admin SDK (from Firebase Console > Project Settings > Service Accounts) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the \n escape sequences literal (do not replace with real newlines) when pasting
# into a single-line env var. The code converts \n back to real newlines automatically.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- CORS ---
# Comma-separated list of origins allowed to call this API (your custom domain + admin panel domain)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com

# --- Crypto ticker (optional) ---
# Leave blank to use free, no-key CoinGecko public endpoint.
# If you have a paid provider key, set CRYPTO_PROVIDER and CRYPTO_PROVIDER_API_KEY
# and extend api/app/services/crypto_service.py accordingly.
CRYPTO_PROVIDER_API_KEY=
